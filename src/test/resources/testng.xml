<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SauceDemoSuite" verbose="1" parallel="false">
    <!-- Suite-level URL -->
    <parameter name="baseUrl" value="https://www.saucedemo.com/"/>

    <!-- Credentials -->
    <parameter name="validUser" value="standard_user"/>
    <parameter name="validPass" value="secret_sauce"/>
    <parameter name="invalidUser" value="standard_Invaliduser"/>
    <parameter name="invalidPass" value="secret_Invalidpwd"/>

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="tests.LoginTests"/>
        </classes>
    </test>
</suite>
